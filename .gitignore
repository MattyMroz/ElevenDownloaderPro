# ── Other stacks — PASTE FOREIGN TEMPLATES HERE, NOT AT THE END ───────────────
# Go, Java, .NET, PHP, Ruby, Terraform, Docker and ~500 more:
# github.com/github/gitignore — paste below this line.
# Everything after this section overrides templates, which is the point.

# ── Project-specific — fill in, delete the rest ───────────────────────────────
workspace/**
!workspace/**/
!workspace/**/.gitkeep
.chrome-profile/
.browser-profile/
recording_*.txt

# ── Re-includes ───────────────────────────────────────────────────────────────
# Every keeper lives HERE, not next to the rule it escapes — a template pasted
# into section 8 would otherwise bury negations written above it.
# Order inside: `!dir/` and `!dir/**/` first, so git can descend; then files.
# Never `!dir/**` — that also lets video and model weights back in.

# Hand-written config
!.claude/
!.claude/settings.json
!.claude/commands/
!.codex/hooks.json
!.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
!.idea/
!.idea/runConfigurations/
!.env.example
!.env.sample
!.env.template

# Committed assets — bundlers also keep them in src/assets, not just assets/
!**/assets/
!**/assets/**/
!public/
!public/**/
!docs/
!docs/**/
!**/src-tauri/icons/**
!**/assets/**/*.png
!**/assets/**/*.jpg
!**/assets/**/*.jpeg
!**/assets/**/*.webp
!**/assets/**/*.svg
!**/assets/**/*.ico
!public/**/*.png
!public/**/*.jpg
!public/**/*.jpeg
!public/**/*.webp
!public/**/*.svg
!public/**/*.ico
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.svg

# Test fixtures — small by definition, and the tests need them in git
!**/fixtures/
!**/fixtures/**/
!**/fixtures/**/*.csv
!**/fixtures/**/*.tsv
!**/fixtures/**/*.parquet
!**/fixtures/**/*.png
!**/fixtures/**/*.jpg
!**/fixtures/**/*.jpeg
!**/fixtures/**/*.webp
!**/fixtures/**/*.gif
!**/fixtures/**/*.ico
!**/fixtures/**/*.zip
!**/fixtures/**/*.bin

# ── Project overrides — ignores that must beat the re-includes above ──────────
# docs/session-logs/
# public/uploads/

# ── Final invariants — MUST STAY LAST ─────────────────────────────────────────
# Enforced, not documented: last match wins, so nothing above can bury these.
!uv.lock
!bun.lock
!bun.lockb
!Cargo.lock
!package-lock.json
!pnpm-lock.yaml
!yarn.lock
!.python-version
!.nvmrc
!.gitignore
!.gitattributes
